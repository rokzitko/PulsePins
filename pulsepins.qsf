#set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to ext_clk

set_global_assignment -name SOURCE_TCL_SCRIPT_FILE pulsepins.tcl
set_global_assignment -name VERILOG_MACRO "DEBUG=1"


set_global_assignment -name SDC_FILE pulsepins.sdc

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# ===============================
# Quartus Prime Lite 21.1 – fMAX boost
# ===============================

# Optimize globally for speed
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE PERFORMANCE"
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name SYNTHESIS_EFFORT AUTO
set_global_assignment -name OPTIMIZE_HOLD_TIMING "ALL PATHS"

# Enable retiming & logic duplication
#set_global_assignment -name AUTO_RETIMING ON
#set_global_assignment -name DUPLICATE_LOGIC_CELL ON
set_global_assignment -name REMOVE_DUPLICATE_REGISTERS ON

# Enable physical synthesis passes (available in Lite)
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT EXTRA

set_global_assignment -name SEED 5

# Allow register packing & clustering
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT HIGH

# Extra fitter clean-up
#set_global_assignment -name FITTER_AGGRESSIVE_REROUTE ON
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM
