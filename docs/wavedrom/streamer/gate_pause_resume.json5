{
  head: {
    text: 'Gate pause and resume during active playback',
  },
  signal: [
    { name: 'streamer_clk',      wave: '010101010101010101010101010101010101' },
    { name: 'trigger_activated', wave: '111111111111111111111111111110000000' },
    { name: 'gate_enable',       wave: '111111111000000000000111111111111111' },
    { name: 'rdreq',             wave: '011111111000000000000111111110000000' },
    { name: 'qout',              wave: '2......3...............4.....5......', data: ['0x11', '0x22 held', '0x44', 'final'] },
    { name: 'qout_valid',        wave: '011111111000000000000111111000000000' },
    { name: 'qout_strobe',       wave: '001010101000000000000010101000000000' },
    { name: 'read_fire && is_last', wave: '000000000000000000000000000001000000' },
    { name: 'done',              wave: '000000000000000000000000000001111111' },
  ],
  foot: {
    text: 'Closing the gate stops new FIFO reads. qout holds its last value, but qout_valid and qout_strobe deassert.',
  },
  config: { hscale: 2 },
}
