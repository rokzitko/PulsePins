# Burst mode
./ppreset
./ppfg -veryverbose -int_pll 10M -burst 3 -period 1ms -trig -veryverbose

# -start0
./ppfg -veryverbose -int_pll 10M -burst 3 -period 1ms -trig -veryverbose -start0

# -t (final value)
./ppfg -veryverbose -int_pll 10M -burst 3 -period 1ms -trig -veryverbose -t 0xFF

# -n_max; with auto trigger just two repetitions of the same burst
./ppfg -veryverbose -int_pll 10M -burst 3 -period 1ms -trig -veryverbose -n_max 2

