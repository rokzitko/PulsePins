my $save_report_files = 1;

while (@ARGV) {
    my $arg = shift @ARGV;
    if ($arg eq '-no-report-files') {
        $save_report_files = 0;
    } else {
        die "Unknown argument: $arg\n";
    }
}

# This will generate a lot of output.
# Use a RAM-based storage mount point, not the SD card!
my $logdir = "/var/volatile";
(-d $logdir && -w $logdir) or die "$logdir not writable.";

system "rm $logdir/report.*" if $save_report_files; # clean up first!

sub get_pptest_report_header {
    my $output = `pptest 0 2>&1`;
    my $version = "Version unavailable";
    my $bitstream_timestamp = "Bitstream timestamp: unavailable";
    for my $line (split /\n/, $output) {
        if ($line =~ /^Version /) {
            $version = $line;
        }
        if ($line =~ /^Bitstream timestamp: /) {
            $bitstream_timestamp = $line;
        }
    }
    return "# run_all_tests_forever report\n# $version\n# $bitstream_timestamp\n\n";
}

my $report_header = get_pptest_report_header();

open (O, ">report");
print O $report_header;

for ($i = 1 ; ; $i++) {
    if ($save_report_files) {
        open(my $R, ">$logdir/report.run_$i") or die "Could not write $logdir/report.run_$i: $!";
        print $R $report_header;
        close($R);
    }
    my $cmd = $save_report_files
        ? "run_all_tests 2>&1 | tee -a $logdir/report.run_$i"
        : "run_all_tests 2>&1";
    system("bash", "-o", "pipefail", "-c", $cmd);
    my $rc = $? >> 8;   # extract exit code
    last if $rc != 0;   # stop if not zero
    chomp($time = `date`);
    print O "$i -- $time\n"; # log successful runs
}
