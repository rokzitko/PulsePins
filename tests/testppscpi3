#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/testppscpi_common.sh"

start_ppscpi
mapfile -t RESPONSE_LINES < <(ppscpi_query '*IDN?;CHECK ON;CHECK?;SEQ d 10 0xff d 5 0x00 d 2 0b0101 f;STREAM;SYST:ERR?')

printf 'Responses:\n'
printf '%s\n' "${RESPONSE_LINES[@]}"

if [[ "${#RESPONSE_LINES[@]}" -ne 5 ]]; then
  ppscpi_fail "expected 5 response lines, got ${#RESPONSE_LINES[@]}"
fi

ppscpi_expect_idn "${RESPONSE_LINES[0]}"
ppscpi_expect_response "CHECK?" "${RESPONSE_LINES[1]}" "TRUE"
ppscpi_expect_response "SEQ" "${RESPONSE_LINES[2]}" "LOADED"
ppscpi_expect_response "STREAM" "${RESPONSE_LINES[3]}" "SUCCESS"
ppscpi_expect_response "SYST:ERR?" "${RESPONSE_LINES[4]}" '0, "No error"'
ppscpi_pass
