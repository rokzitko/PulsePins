use strict;
use warnings;
use File::Basename;
use File::Path qw(make_path);

sub system_failure {
  my ($status) = @_;
  if ($status == -1) {
    return (127, "failed to execute: $!");
  }
  if ($status & 127) {
    my $signal = $status & 127;
    my $core = ($status & 128) ? " with core dump" : "";
    return (128 + $signal, "killed by signal $signal$core");
  }
  my $rc = $status >> 8;
  return $rc == 0 ? (0, "") : ($rc, "exited with code $rc");
}

my $skip_re;

while (@ARGV) {
    my $arg = shift @ARGV;
    if ($arg eq '-skip') {
        defined($skip_re = shift @ARGV)
          or die "-skip requires a regular expression argument\n";
    } else {
        die "Unknown argument: $arg\n";
    }
}

# This will generate a lot of output.
# Use a RAM-based storage mount point, not the SD card!
my $logdir = "/var/volatile/pulsepins-test-logs";
make_path($logdir) unless -d $logdir;
(-d $logdir && -w $logdir) or die "$logdir not writable.";

my $cntr = 0;

chdir("/home/root/tests") or die;

for my $t (glob "./test*") {
  next unless -f $t && -x $t;
  next if $t =~ /-inf/;   # skip if "-inf" in filename (infinite duration tests)
  next if $t =~ /-pll/;   # skip if "-pll" in filename, these are best run manually
  next if defined($skip_re) && $t =~ /$skip_re/;  # user-specified skips

  my $test = basename($t);
  my $logfile = "$logdir/report.$test";
  print "\nRunning $t [$test]...\n";
  my $status = system("bash", "-o", "pipefail", "-c", '"$1" 2>&1 | tee "$2"', "run_all_tests", $t, $logfile);
  my ($rc, $failure) = system_failure($status);
  if ($rc != 0) {
    print "FAILED: $failure\n";
    exit($rc);
  }
}

print "SUCCESS\n";
